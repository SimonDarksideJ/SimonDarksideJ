<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CameraAnimation</RootNamespace>
    <AssemblyName>CameraAnimation</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Reusable animated camera system for MonoGame with idle detection, multiple animation modes, and smooth transitions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
  </ItemGroup>

</Project>
